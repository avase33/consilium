# Copy to .env and fill in to go live. With nothing set, Consilium runs fully
# offline on a deterministic mock model + mock search.

# --- LLM provider (auto-detected from keys if unset) ---
# CONSILIUM_PROVIDER=anthropic          # mock | anthropic | openai
# ANTHROPIC_API_KEY=sk-ant-...
# OPENAI_API_KEY=sk-...
# CONSILIUM_MODEL=claude-3-5-sonnet-latest

# --- Web search backend ---
# CONSILIUM_SEARCH=tavily               # mock | tavily
# TAVILY_API_KEY=tvly-...

# --- Orchestration ---
# CONSILIUM_ORCHESTRATOR=builtin        # builtin | langgraph
# CONSILIUM_SUBTOPICS=4
# CONSILIUM_MAX_ITERATIONS=2
# CONSILIUM_CRITIQUE_THRESHOLD=7.0
# CONSILIUM_RESULTS_PER_QUERY=4

# --- Infra ---
# CONSILIUM_DB=consilium.db
# CONSILIUM_CACHE=true
# CONSILIUM_LOG_LEVEL=INFO
# CONSILIUM_LOG_JSON=false
# REDIS_URL=redis://localhost:6379
